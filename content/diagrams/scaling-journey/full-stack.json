{
  "schemaVersion": 1,
  "id": "full-stack",
  "title": "Step 3 — the shape most large systems settle into",
  "description": "Static assets on a CDN, a stateless web tier behind a load balancer, a cache in front of replicated databases, and slow work pushed onto a queue.",
  "groups": [
    { "id": "g_user", "label": "User", "position": { "x": 300, "y": 0 }, "size": { "width": 340, "height": 140 }, "style": "solid" },
    { "id": "g_web", "label": "Web tier", "position": { "x": 250, "y": 400 }, "size": { "width": 440, "height": 160 }, "style": "dashed", "labelPosition": "right" },
    { "id": "g_data", "label": "Data tier", "position": { "x": 180, "y": 700 }, "size": { "width": 460, "height": 170 }, "style": "dashed", "labelPosition": "right" }
  ],
  "nodes": [
    { "id": "browser", "type": "client", "label": "Web browser", "position": { "x": 30, "y": 30 }, "groupId": "g_user" },
    { "id": "mobile", "type": "client_mobile", "label": "Mobile app", "position": { "x": 190, "y": 30 }, "groupId": "g_user" },
    { "id": "dns", "type": "dns", "label": "DNS", "position": { "x": 60, "y": 40 } },
    { "id": "cdn", "type": "cdn", "label": "CDN", "sublabel": "static assets", "position": { "x": 800, "y": 40 }, "badge": 1 },
    { "id": "lb", "type": "load_balancer", "label": "Load balancer", "position": { "x": 420, "y": 250 } },
    { "id": "web1", "type": "server", "label": "Server 1", "position": { "x": 50, "y": 40 }, "groupId": "g_web" },
    { "id": "web2", "type": "server", "label": "Server 2", "position": { "x": 180, "y": 40 }, "groupId": "g_web" },
    { "id": "web3", "type": "server", "label": "Server 3", "position": { "x": 310, "y": 40 }, "groupId": "g_web" },
    { "id": "cache", "type": "cache_stack", "label": "Cache", "sublabel": "hot reads", "position": { "x": 800, "y": 450 }, "badge": 2 },
    { "id": "master", "type": "database", "label": "Master DB", "sublabel": "writes", "position": { "x": 50, "y": 45 }, "groupId": "g_data" },
    { "id": "slave", "type": "database_stack", "label": "Replicas", "sublabel": "reads", "position": { "x": 290, "y": 45 }, "groupId": "g_data" },
    { "id": "queue", "type": "message_queue", "label": "Message queue", "position": { "x": 790, "y": 640 }, "badge": 3 },
    { "id": "workers", "type": "worker_stack", "label": "Workers", "sublabel": "slow jobs", "position": { "x": 810, "y": 800 } }
  ],
  "edges": [
    { "id": "e_dns", "source": "dns", "target": "browser", "label": "resolve", "sourceHandle": "right", "targetHandle": "left", "direction": "both" },
    { "id": "e_cdn", "source": "browser", "target": "cdn", "label": "static assets", "sourceHandle": "right", "targetHandle": "left", "direction": "both" },
    { "id": "e_lb", "source": "browser", "target": "lb", "label": "HTTP", "step": 1, "sourceHandle": "bottom", "targetHandle": "top" },
    { "id": "e_lb2", "source": "mobile", "target": "lb", "label": "HTTP", "sourceHandle": "bottom", "targetHandle": "top" },
    { "id": "e_w1", "source": "lb", "target": "web1", "step": 2, "sourceHandle": "bottom", "targetHandle": "top" },
    { "id": "e_w2", "source": "lb", "target": "web2", "step": 2, "sourceHandle": "bottom", "targetHandle": "top" },
    { "id": "e_w3", "source": "lb", "target": "web3", "step": 2, "sourceHandle": "bottom", "targetHandle": "top" },
    { "id": "e_cache", "source": "web3", "target": "cache", "label": "read-through", "step": 3, "color": "purple", "sourceHandle": "right", "targetHandle": "left", "direction": "both" },
    { "id": "e_write", "source": "web1", "target": "master", "label": "write", "step": 4, "color": "blue", "sourceHandle": "bottom", "targetHandle": "top" },
    { "id": "e_read", "source": "web2", "target": "slave", "label": "read", "step": 4, "color": "green", "sourceHandle": "bottom", "targetHandle": "top" },
    { "id": "e_repl", "source": "master", "target": "slave", "label": "replicate", "lineStyle": "dashed", "color": "gray", "sourceHandle": "right", "targetHandle": "left" },
    { "id": "e_enq", "source": "web3", "target": "queue", "label": "enqueue job", "step": 5, "color": "purple", "sourceHandle": "right", "targetHandle": "left" },
    { "id": "e_work", "source": "queue", "target": "workers", "label": "consume", "step": 6, "color": "purple", "sourceHandle": "bottom", "targetHandle": "top" }
  ],
  "flows": [
    {
      "id": "read-path",
      "name": "Serving a read",
      "steps": [
        { "edgeIds": ["e_lb", "e_lb2"], "text": "DNS points clients at the load balancer. No client ever addresses a web server directly." },
        { "edgeIds": ["e_w1", "e_w2", "e_w3"], "text": "The load balancer picks a healthy server. Because the tier is stateless, any of them can serve any request." },
        { "edgeIds": ["e_cache"], "text": "The server checks the cache first. Most reads stop here and never reach a database." },
        { "edgeIds": ["e_read", "e_repl"], "text": "On a miss it reads from a replica. The master streams changes to replicas asynchronously, so replicas may lag slightly." }
      ]
    },
    {
      "id": "write-path",
      "name": "Handling a write",
      "steps": [
        { "edgeIds": ["e_lb"], "text": "The write arrives through the same load balancer." },
        { "edgeIds": ["e_write"], "text": "Writes go only to the master. Sending them to a replica would create conflicting histories." },
        { "edgeIds": ["e_enq"], "text": "Anything slow — resizing an image, sending mail — is enqueued rather than done inline, so the response returns immediately." },
        { "edgeIds": ["e_work"], "text": "Workers drain the queue at their own pace. If they fall behind, work accumulates instead of being lost." }
      ]
    }
  ]
}
