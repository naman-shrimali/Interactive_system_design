{
  "schemaVersion": 1,
  "id": "rehashing-problem",
  "title": "Why modulo hashing collapses when a server leaves",
  "description": "Four keys, four servers, one failure. The keys did not move — the mapping moved out from under them, and every lookup misses at once.",
  "nodes": [
    {
      "id": "before",
      "type": "table",
      "label": "4 servers — hash(key) % 4",
      "position": {
        "x": 40,
        "y": 40
      },
      "tableData": {
        "columns": [
          "key",
          "hash",
          "% 4",
          "machine"
        ],
        "rows": [
          [
            "k1",
            "101",
            "1",
            "S1"
          ],
          [
            "k2",
            "102",
            "2",
            "S2"
          ],
          [
            "k3",
            "103",
            "3",
            "S3"
          ],
          [
            "k4",
            "104",
            "0",
            "S0"
          ]
        ]
      }
    },
    {
      "id": "renumber",
      "type": "text_box",
      "label": "S1 dies — survivors are renumbered",
      "sublabel": "Modulo needs a contiguous 0..N-1.\nWith 3 left, the index space is 0,1,2\nand it now points at different machines:\n  index 0 → S0\n  index 1 → S2\n  index 2 → S3",
      "position": {
        "x": 470,
        "y": 300
      }
    },
    {
      "id": "after",
      "type": "table",
      "label": "3 servers — hash(key) % 3",
      "position": {
        "x": 800,
        "y": 40
      },
      "tableData": {
        "columns": [
          "key",
          "hash",
          "% 3",
          "machine",
          "was"
        ],
        "rows": [
          [
            "k1",
            "101",
            "2",
            "S3",
            "S1 ✗"
          ],
          [
            "k2",
            "102",
            "0",
            "S0",
            "S2 ✗"
          ],
          [
            "k3",
            "103",
            "1",
            "S2",
            "S3 ✗"
          ],
          [
            "k4",
            "104",
            "2",
            "S3",
            "S0 ✗"
          ]
        ]
      }
    },
    {
      "id": "note",
      "type": "text_box",
      "label": "All four keys moved",
      "sublabel": "Removing 1 of N servers remaps\nabout (N−1)/N of all keys.\n4 servers → 75%. 10 → 90%.",
      "position": {
        "x": 60,
        "y": 320
      }
    },
    {
      "id": "cache",
      "type": "cache_stack",
      "label": "Cache tier",
      "sublabel": "every lookup now misses",
      "position": {
        "x": 130,
        "y": 560
      }
    },
    {
      "id": "db",
      "type": "database",
      "label": "Database",
      "sublabel": "takes the full read load",
      "position": {
        "x": 700,
        "y": 560
      }
    }
  ],
  "edges": [
    {
      "id": "e_fail",
      "source": "before",
      "target": "renumber",
      "label": "one server leaves",
      "step": 1,
      "color": "red",
      "sourceHandle": "right",
      "targetHandle": "left"
    },
    {
      "id": "e_remap",
      "source": "renumber",
      "target": "after",
      "label": "indices point elsewhere",
      "step": 2,
      "color": "red",
      "sourceHandle": "right",
      "targetHandle": "left"
    },
    {
      "id": "e_miss",
      "source": "note",
      "target": "cache",
      "label": "mass miss",
      "step": 3,
      "color": "red",
      "sourceHandle": "bottom",
      "targetHandle": "top"
    },
    {
      "id": "e_stampede",
      "source": "cache",
      "target": "db",
      "label": "stampede",
      "step": 4,
      "color": "red",
      "sourceHandle": "right",
      "targetHandle": "left"
    }
  ],
  "flows": [
    {
      "id": "collapse",
      "name": "What one failure costs",
      "steps": [
        {
          "edgeIds": [
            "e_fail"
          ],
          "text": "S1 fails. Modulo hashing needs a contiguous index space, so the three survivors are renumbered 0, 1, 2 — and those indices no longer refer to the machines they referred to before."
        },
        {
          "edgeIds": [
            "e_remap"
          ],
          "text": "Recompute with % 3 and compare the 'machine' column to 'was'. Every one of the four keys now resolves to a different physical machine — including k3, which moves from S3 to S2. Note that no key resolves to S1: it is gone from the index space entirely."
        },
        {
          "edgeIds": [
            "e_miss"
          ],
          "text": "The data is still sitting in the cache tier; the cluster has simply stopped looking for it in the right place. Every subsequent lookup misses."
        },
        {
          "edgeIds": [
            "e_stampede"
          ],
          "text": "Those misses fall through to the database — which now absorbs the entire read load of the system, at the exact moment you are already one server down. A routine node failure has become an outage."
        }
      ]
    }
  ]
}
