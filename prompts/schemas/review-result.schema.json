{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://interactive-system-design.local/prompts/review-result.schema.json",
  "title": "Interactive System Design lesson review result",
  "type": "object",
  "required": [
    "lesson",
    "overall_verdict",
    "summary",
    "claims",
    "gaps",
    "recommended_changes",
    "sources"
  ],
  "properties": {
    "lesson": {
      "type": "object",
      "required": ["topic_slug", "section_slug"],
      "properties": {
        "topic_slug": {"type": "string"},
        "section_slug": {"type": "string"},
        "title": {"type": "string"},
        "provenance": {"enum": ["authored", "primer", "mixed", "unknown"]}
      },
      "additionalProperties": false
    },
    "overall_verdict": {
      "enum": ["ready", "ready_with_changes", "needs_revision", "blocked", "unverified"]
    },
    "summary": {"type": "string"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "classification", "verdict", "evidence", "confidence"],
        "properties": {
          "claim": {"type": "string"},
          "classification": {"type": "string"},
          "verdict": {"enum": ["supported", "partially_supported", "unsupported", "outdated", "misleading", "unverified"]},
          "evidence": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "confidence": {"enum": ["high", "medium", "low"]}
        },
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap", "priority", "why_it_matters", "confidence"],
        "properties": {
          "gap": {"type": "string"},
          "priority": {"enum": ["critical", "important", "enrichment"]},
          "why_it_matters": {"type": "string"},
          "proposed_location": {"type": "string"},
          "smallest_addition": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string"}},
          "confidence": {"enum": ["high", "medium", "low"]}
        },
        "additionalProperties": false
      }
    },
    "recommended_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["change", "priority"],
        "properties": {
          "change": {"type": "string"},
          "priority": {"enum": ["P0", "P1", "P2"]},
          "reason": {"type": "string"},
          "source_ids": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "interview_readiness": {
      "type": "object",
      "properties": {
        "score_0_to_4": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 4}},
        "critical_omissions": {"type": "array", "items": {"type": "string"}},
        "follow_up_questions": {"type": "array", "items": {"type": "string"}},
        "practice_prompt": {"type": "string"}
      },
      "additionalProperties": false
    },
    "replacement_markdown": {"type": "string"},
    "change_log": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "url", "accessed"],
        "properties": {
          "id": {"type": "string"},
          "url": {"type": "string", "pattern": "^https?://"},
          "title": {"type": "string"},
          "accessed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "published_or_updated": {"type": "string"},
          "role": {"enum": ["normative", "authoritative", "interview"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
