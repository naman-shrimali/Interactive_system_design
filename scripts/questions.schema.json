{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Interview questions, misconceptions, and traps",
  "type": "object",
  "required": ["schemaVersion", "entries"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["topic", "kind", "prompt", "answer"],
        "additionalProperties": false,
        "properties": {
          "topic": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "kind": {
            "description": "question = asked directly; misconception = a plausible belief that is wrong; trap = the obvious answer fails.",
            "enum": ["question", "misconception", "trap"]
          },
          "prompt": {
            "description": "For a question, the question. For a misconception, the wrong belief stated plainly as someone would say it.",
            "type": "string",
            "minLength": 12
          },
          "answer": { "type": "string", "minLength": 60 },
          "source": {
            "description": "Required for misconception and trap — a correction must be traceable to a curated source.",
            "type": "string",
            "pattern": "^https://"
          },
          "followUp": {
            "description": "What a good interviewer asks next once you answer well.",
            "type": "string",
            "minLength": 10
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "enum": ["misconception", "trap"] } } },
            "then": { "required": ["source"] }
          }
        ]
      }
    }
  }
}
