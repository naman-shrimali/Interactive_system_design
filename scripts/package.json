{
  "name": "isd-scripts",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "ingest": "tsx ingest/parse-primer.ts && tsx ingest/build-curriculum.ts",
    "ingest:parse": "tsx ingest/parse-primer.ts",
    "ingest:build": "tsx ingest/build-curriculum.ts",
    "validate:diagrams": "tsx validate-diagrams.ts",
    "validate:code": "tsx validate-code.ts",
    "validate": "npm run validate:diagrams && npm run validate:code",
    "export:static": "tsx export-static.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
