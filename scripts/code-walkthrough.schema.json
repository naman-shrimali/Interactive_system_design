{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CodeWalkthrough",
  "description": "A step-by-step dry run of a topic, written the way you would talk through it at a whiteboard. Steps that involve infrastructure rather than code carry a one-line note instead of a snippet.",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "steps"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "intro": { "type": "string" },
    "language": { "enum": ["javascript", "typescript", "sql", "bash"], "default": "javascript" },
    "closing": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["title", "kind", "explain"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["code", "infra"],
            "description": "code = a snippet the learner writes; infra = a component with no code to write (a queue, a CDN, a container), described in one line so the flow stays continuous."
          },
          "code": { "type": "string" },
          "language": { "enum": ["javascript", "typescript", "sql", "bash"] },
          "explain": {
            "type": "string",
            "description": "What you would SAY while writing this step — the reasoning, not a restatement of the code."
          },
          "saysOutLoud": {
            "type": "string",
            "description": "Optional one-liner to deliver verbatim in an interview."
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "code" } } },
            "then": { "required": ["code"] }
          },
          {
            "if": { "properties": { "kind": { "const": "infra" } } },
            "then": { "not": { "required": ["code"] } }
          }
        ]
      }
    }
  }
}
